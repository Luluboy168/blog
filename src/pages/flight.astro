---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Sky High | ${SITE_TITLE}`} description="A 3D flight simulator built with Three.js." />
    <style>
      body {
        margin: 0;
        overflow: hidden;
        background: #000;
      }
      #game-container {
        position: relative;
        width: 100vw;
        height: 100vh;
      }
      #ui {
        position: absolute;
        top: 80px;
        left: 20px;
        color: white;
        font-family: 'Outfit', sans-serif;
        pointer-events: none;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
      }
      .stat {
        margin-bottom: 10px;
      }
      .stat-label {
        font-size: 0.8rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #00f2ff;
      }
      #overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 100;
        color: white;
        text-align: center;
        backdrop-filter: blur(10px);
      }
      #overlay h1 {
        font-size: 4rem;
        margin-bottom: 10px;
        background: linear-gradient(45deg, #00f2ff, #0066ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .controls-info {
        margin: 20px 0;
        color: #ccc;
      }
      #start-btn {
        padding: 15px 40px;
        font-size: 1.2rem;
        background: #00f2ff;
        color: #000;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        font-weight: 700;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }
      #start-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 0 30px rgba(0, 242, 255, 0.4);
      }
      .back-btn {
        position: absolute;
        top: 100px;
        right: 20px;
        color: white;
        text-decoration: none;
        background: rgba(255,255,255,0.1);
        padding: 10px 20px;
        border-radius: 20px;
        backdrop-filter: blur(5px);
        font-size: 0.9rem;
        z-index: 10;
        transition: background 0.2s;
      }
      .back-btn:hover {
        background: rgba(255,255,255,0.2);
      }
    </style>
	</head>
	<body>
		<Header />
    <div id="game-container">
      <a href="/blog/games/" class="back-btn">← Back to Arcade</a>
      
      <div id="ui">
        <div class="stat">
          <div class="stat-label">Distance</div>
          <div class="stat-value" id="score">0m</div>
        </div>
        <div class="stat">
          <div class="stat-label">Altitude</div>
          <div class="stat-value" id="altitude">0m</div>
        </div>
      </div>

      <div id="overlay">
        <h1>SKY HIGH</h1>
        <p>A 3D Paper Plane Simulator</p>
        <div class="controls-info">
          <p>W / S or ↑ / ↓ : Pitch (Up/Down)</p>
          <p>A / D or ← / → : Roll (Left/Right)</p>
          <p>Collect Blue Rings for Speed Boosts!</p>
        </div>
        <button id="start-btn">TAKE OFF</button>
      </div>
    </div>
		<Footer />

    <script type="module">
      import * as THREE from 'https://esm.sh/three@0.160.0';

      let scene, camera, renderer, plane, ocean, clouds = [];
      let rings = [];
      let score = 0;
      let gameStarted = false;
      let lastTime = 0;
      
      // Constants
      const WORLD_SIZE = 5000;
      const RING_COUNT = 20;
      const CLOUD_COUNT = 100;

      // Flight variables
      let velocity = new THREE.Vector3(0, 0, 0);
      let rotation = new THREE.Vector3(0, 0, 0);
      const speed = 0.8;
      const turnSpeed = 0.03;
      const keys = {};

      function init() {
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x87ceeb);
        scene.fog = new THREE.Fog(0x87ceeb, 100, 1000);

        camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 2000);
        
        renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.shadowMap.enabled = true;
        document.getElementById('game-container').appendChild(renderer.domElement);

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const sun = new THREE.DirectionalLight(0xffffff, 1);
        sun.position.set(100, 200, 100);
        sun.castShadow = true;
        sun.shadow.camera.left = -200;
        sun.shadow.camera.right = 200;
        sun.shadow.camera.top = 200;
        sun.shadow.camera.bottom = -200;
        scene.add(sun);

        createPlane();
        createEnvironment();
        createRings();

        window.addEventListener('resize', onWindowResize);
        document.addEventListener('keydown', e => keys[e.code] = true);
        document.addEventListener('keyup', e => keys[e.code] = false);
        document.getElementById('start-btn').addEventListener('click', startGame);

        animate();
      }

      function createPlane() {
        const group = new THREE.Group();
        
        // Low-poly paper plane style
        const bodyGeom = new THREE.ConeGeometry(0.5, 3, 4);
        bodyGeom.rotateX(Math.PI / 2);
        const mat = new THREE.MeshPhongMaterial({ 
          color: 0xffffff, 
          flatShading: true,
          side: THREE.DoubleSide 
        });
        
        const body = new THREE.Mesh(bodyGeom, mat);
        body.castShadow = true;
        group.add(body);

        // Wings
        const wingGeom = new THREE.PlaneGeometry(5, 2);
        wingGeom.rotateX(-Math.PI / 2);
        const wing = new THREE.Mesh(wingGeom, mat);
        wing.position.z = -0.5;
        wing.castShadow = true;
        group.add(wing);

        // Vertical Tail
        const tailGeom = new THREE.PlaneGeometry(1, 1);
        tailGeom.rotateY(Math.PI / 2);
        const tail = new THREE.Mesh(tailGeom, mat);
        tail.position.y = 0.5;
        tail.position.z = -1;
        tail.castShadow = true;
        group.add(tail);

        plane = group;
        scene.add(plane);
        
        // Initial position
        plane.position.y = 50;
      }

      function createEnvironment() {
        // Ocean
        const oceanGeom = new THREE.PlaneGeometry(WORLD_SIZE, WORLD_SIZE, 20, 20);
        oceanGeom.rotateX(-Math.PI / 2);
        const oceanMat = new THREE.MeshPhongMaterial({ 
          color: 0x006994, 
          transparent: true, 
          opacity: 0.8,
          flatShading: true
        });
        ocean = new THREE.Mesh(oceanGeom, oceanMat);
        ocean.receiveShadow = true;
        scene.add(ocean);

        // Clouds
        for (let i = 0; i < CLOUD_COUNT; i++) {
          const cloud = createCloud();
          cloud.position.set(
            (Math.random() - 0.5) * WORLD_SIZE * 0.5,
            Math.random() * 200 + 50,
            (Math.random() - 0.5) * WORLD_SIZE * 0.5
          );
          scene.add(cloud);
          clouds.push(cloud);
        }
      }

      function createCloud() {
        const group = new THREE.Group();
        const mat = new THREE.MeshPhongMaterial({ color: 0xffffff, flatShading: true });
        const nBlobs = 3 + Math.floor(Math.random() * 4);
        
        for (let i = 0; i < nBlobs; i++) {
          const geom = new THREE.SphereGeometry(2 + Math.random() * 5, 8, 8);
          const mesh = new THREE.Mesh(geom, mat);
          mesh.position.x = i * 4;
          mesh.position.y = Math.random() * 3;
          mesh.position.z = Math.random() * 3;
          group.add(mesh);
        }
        return group;
      }

      function createRings() {
        const ringGeom = new THREE.TorusGeometry(8, 0.5, 8, 24);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x00f2ff, transparent: true, opacity: 0.6 });
        
        for (let i = 0; i < RING_COUNT; i++) {
          const ring = new THREE.Mesh(ringGeom, ringMat);
          resetRing(ring);
          scene.add(ring);
          rings.push(ring);
        }
      }

      function resetRing(ring) {
        // Place ring ahead of the plane
        const dist = 500 + Math.random() * 1000;
        
        ring.position.x = plane.position.x + (Math.random() - 0.5) * 600;
        ring.position.y = Math.max(20, plane.position.y + (Math.random() - 0.5) * 150);
        ring.position.z = plane.position.z + dist;
        
        ring.lookAt(plane.position);
      }

      function startGame() {
        gameStarted = true;
        document.getElementById('overlay').style.display = 'none';
        lastTime = performance.now();
      }

      function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      }

      function updateFlight() {
        if (!gameStarted) return;

        // Input handling
        if (keys['ArrowUp'] || keys['KeyW']) plane.rotation.x -= turnSpeed;
        if (keys['ArrowDown'] || keys['KeyS']) plane.rotation.x += turnSpeed;
        if (keys['ArrowLeft'] || keys['KeyA']) {
          plane.rotation.z += turnSpeed;
          plane.rotation.y += turnSpeed * 0.5;
        }
        if (keys['ArrowRight'] || keys['KeyD']) {
          plane.rotation.z -= turnSpeed;
          plane.rotation.y -= turnSpeed * 0.5;
        }

        // Limit rotation
        plane.rotation.x = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, plane.rotation.x));
        plane.rotation.z = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, plane.rotation.z));

        // Auto-level
        plane.rotation.z *= 0.95;
        plane.rotation.x *= 0.98;

        // Movement
        plane.translateZ(speed + (Math.abs(plane.rotation.x) * 0.2));
        
        // Gravity effect
        plane.position.y -= 0.05 + (plane.rotation.x * 0.1);
        
        // Floor constraint
        if (plane.position.y < 2) {
          plane.position.y = 2;
          gameOver();
        }

        // Update UI
        score += speed * 0.1;
        document.getElementById('score').innerText = Math.floor(score) + 'm';
        document.getElementById('altitude').innerText = Math.floor(plane.position.y) + 'm';

        // Camera follow (Smooth)
        const offset = new THREE.Vector3(0, 5, -15);
        offset.applyQuaternion(plane.quaternion);
        offset.add(plane.position);
        
        camera.position.lerp(offset, 0.1);
        camera.lookAt(plane.position.x, plane.position.y + 2, plane.position.z + 5);

        // Ring collection
        rings.forEach(ring => {
          if (plane.position.distanceTo(ring.position) < 10) {
            score += 100;
            resetRing(ring);
            // Flash effect
            scene.background = new THREE.Color(0xffffff);
            setTimeout(() => scene.background = new THREE.Color(0x87ceeb), 50);
          }
          
          // Move rings that are behind
          if (ring.position.z < plane.position.z - 100) {
            resetRing(ring);
          }
        });

        // Endless environment (Move ocean and clouds with plane)
        ocean.position.x = plane.position.x;
        ocean.position.z = plane.position.z;
        
        clouds.forEach(cloud => {
          if (cloud.position.z < plane.position.z - 500) {
            cloud.position.z += WORLD_SIZE * 0.5;
            cloud.position.x = plane.position.x + (Math.random() - 0.5) * WORLD_SIZE * 0.5;
          }
        });
      }

      function gameOver() {
        gameStarted = false;
        document.getElementById('overlay').style.display = 'flex';
        document.getElementById('overlay').querySelector('h1').innerText = 'CRASHED!';
        document.getElementById('start-btn').innerText = 'RETRY';
        score = 0;
        plane.position.set(0, 50, 0);
        plane.rotation.set(0, 0, 0);
      }

      function animate(time) {
        requestAnimationFrame(animate);
        updateFlight();
        
        // Gentle animations
        if (ocean) {
          ocean.geometry.verticesNeedUpdate = true; // Not in BufferGeometry
        }
        
        renderer.render(scene, camera);
      }

      init();
    </script>
	</body>
</html>

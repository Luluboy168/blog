---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Robot Arm Simulator | ${SITE_TITLE}`} description="Interactive 2D Robot Arm Inverse Kinematics Simulator." />
		<style>
			.tool-container {
				max-width: 1000px;
				margin: 0 auto;
				padding: 2rem;
				color: #e0e0e0;
				font-family: 'Inter', system-ui, sans-serif;
			}
			.tool-header {
				text-align: center;
				margin-bottom: 2rem;
			}
			.tool-header h1 {
				font-size: 2.5rem;
				margin: 0.5rem 0;
				background: linear-gradient(90deg, #00ffcc, #3399ff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				text-transform: uppercase;
				letter-spacing: 2px;
			}
			.back-link {
				color: #888;
				text-decoration: none;
				font-size: 0.9rem;
				display: inline-block;
				margin-bottom: 1rem;
				transition: color 0.2s;
			}
			.back-link:hover {
				color: #00ffcc;
			}
			
			/* Simulator Area */
			.sim-wrapper {
				background: #050505;
				border: 1px solid #333;
				border-radius: 12px;
				padding: 1rem;
				box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 1rem;
				overflow: hidden;
			}
			
			@media (max-width: 800px) {
				.sim-wrapper {
					grid-template-columns: 1fr;
				}
			}

			.canvas-container {
				position: relative;
				width: 100%;
				height: 500px;
				background: radial-gradient(circle at center, #111 0%, #000 100%);
				border: 1px solid #222;
				border-radius: 8px;
				overflow: hidden;
				cursor: crosshair;
			}
			
			canvas {
				display: block;
				width: 100%;
				height: 100%;
			}

			/* HUD / Sidebar */
			.hud-panel {
				background: #0a0a0a;
				border: 1px solid #222;
				border-radius: 8px;
				padding: 1.5rem;
				font-family: 'Courier New', Courier, monospace;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.hud-section {
				border-bottom: 1px solid #222;
				padding-bottom: 1rem;
			}
			.hud-section:last-child {
				border-bottom: none;
			}

			.hud-title {
				color: #00ffcc;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 1px;
				margin-bottom: 0.8rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.hud-title::before {
				content: '';
				display: block;
				width: 8px;
				height: 8px;
				background: #00ffcc;
				border-radius: 50%;
				box-shadow: 0 0 5px #00ffcc;
			}

			.data-row {
				display: flex;
				justify-content: space-between;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
				color: #888;
			}
			.data-val {
				color: #fff;
				font-weight: bold;
			}

			.status-indicator {
				display: inline-block;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: bold;
				background: #111;
				color: #555;
				border: 1px solid #333;
			}
			.status-indicator.active {
				background: rgba(0, 255, 204, 0.1);
				color: #00ffcc;
				border-color: #00ffcc;
			}
			.status-indicator.error {
				background: rgba(255, 50, 50, 0.1);
				color: #ff3333;
				border-color: #ff3333;
			}

			.controls {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			
			.control-group label {
				display: block;
				font-size: 0.8rem;
				color: #888;
				margin-bottom: 0.3rem;
			}
			
			input[type="range"] {
				width: 100%;
				background: #222;
				height: 4px;
				border-radius: 2px;
				appearance: none;
			}
			input[type="range"]::-webkit-slider-thumb {
				appearance: none;
				width: 16px;
				height: 16px;
				background: #3399ff;
				border-radius: 50%;
				cursor: pointer;
				transition: transform 0.1s;
			}
			input[type="range"]::-webkit-slider-thumb:hover {
				transform: scale(1.2);
			}

			.instructions {
				font-size: 0.8rem;
				color: #666;
				margin-top: auto;
				line-height: 1.4;
				border-top: 1px solid #222;
				padding-top: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-container">
				<div class="tool-header">
					<a href="/blog/tools" class="back-link">← Back to Tools</a>
					<h1>Robot Arm Simulator</h1>
					<p>2-Link Inverse Kinematics Solver</p>
				</div>

				<div class="sim-wrapper">
					<div class="canvas-container" id="canvas-container">
						<canvas id="sim-canvas"></canvas>
					</div>

					<div class="hud-panel">
						<div class="hud-section">
							<div class="hud-title">System Status</div>
							<div class="data-row">
								<span>State</span>
								<span id="status-badge" class="status-indicator active">ONLINE</span>
							</div>
							<div class="data-row">
								<span>Target</span>
								<span id="target-coords" class="data-val">X: 0 Y: 0</span>
							</div>
						</div>

						<div class="hud-section">
							<div class="hud-title">Joint Telemetry</div>
							<div class="data-row">
								<span>Base (θ1)</span>
								<span id="val-theta1" class="data-val">0.0°</span>
							</div>
							<div class="data-row">
								<span>Elbow (θ2)</span>
								<span id="val-theta2" class="data-val">0.0°</span>
							</div>
						</div>

						<div class="hud-section controls">
							<div class="hud-title">Configuration</div>
							<div class="control-group">
								<label>Link 1 Length</label>
								<input type="range" id="slider-l1" min="50" max="200" value="150">
							</div>
							<div class="control-group">
								<label>Link 2 Length</label>
								<input type="range" id="slider-l2" min="50" max="200" value="120">
							</div>
						</div>
						
						<div class="instructions">
							> Click or Drag in the viewport to move target.<br>
							> Arm will attempt to solve for angles.<br>
							> Red indicator means target unreachable.
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			// Simulation Config
			const canvas = document.getElementById('sim-canvas');
			const ctx = canvas.getContext('2d');
			const container = document.getElementById('canvas-container');
			
			// State
			let l1 = 150;
			let l2 = 120;
			let target = { x: 200, y: 100 }; // Relative to center
			let mouse = { x: 0, y: 0, down: false };
			let origin = { x: 0, y: 0 };
			let joints = { t1: 0, t2: 0, x1: 0, y1: 0, x2: 0, y2: 0 };
			let reachable = true;

			// Elements
			const elTheta1 = document.getElementById('val-theta1');
			const elTheta2 = document.getElementById('val-theta2');
			const elTarget = document.getElementById('target-coords');
			const elStatus = document.getElementById('status-badge');
			const sliderL1 = document.getElementById('slider-l1');
			const sliderL2 = document.getElementById('slider-l2');

			// Init
			function resize() {
				canvas.width = container.clientWidth;
				canvas.height = container.clientHeight;
				origin.x = canvas.width / 2;
				origin.y = canvas.height * 0.7; // Base near bottom
				draw();
			}
			window.addEventListener('resize', resize);
			
			// Input Handling
			function updateTarget(clientX, clientY) {
				const rect = canvas.getBoundingClientRect();
				const mx = clientX - rect.left;
				const my = clientY - rect.top;
				
				// Convert to cartesian relative to base
				target.x = mx - origin.x;
				target.y = origin.y - my; // Flip Y for standard math (up is positive)
				
				solveIK();
				draw();
			}

			canvas.addEventListener('mousedown', (e) => {
				mouse.down = true;
				updateTarget(e.clientX, e.clientY);
			});
			window.addEventListener('mousemove', (e) => {
				if (mouse.down) updateTarget(e.clientX, e.clientY);
			});
			window.addEventListener('mouseup', () => {
				mouse.down = false;
			});
			// Touch support
			canvas.addEventListener('touchstart', (e) => {
				e.preventDefault();
				mouse.down = true;
				updateTarget(e.touches[0].clientX, e.touches[0].clientY);
			});
			canvas.addEventListener('touchmove', (e) => {
				e.preventDefault();
				if(mouse.down) updateTarget(e.touches[0].clientX, e.touches[0].clientY);
			});

			sliderL1.addEventListener('input', (e) => { l1 = parseInt(e.target.value); solveIK(); draw(); });
			sliderL2.addEventListener('input', (e) => { l2 = parseInt(e.target.value); solveIK(); draw(); });

			// Inverse Kinematics
			function solveIK() {
				const x = target.x;
				const y = target.y;
				const distSq = x*x + y*y;
				const dist = Math.sqrt(distSq);

				// Check reachability
				if (dist > l1 + l2 || dist < Math.abs(l1 - l2)) {
					reachable = false;
					elStatus.innerText = "UNREACHABLE";
					elStatus.className = "status-indicator error";
				} else {
					reachable = true;
					elStatus.innerText = "ONLINE";
					elStatus.className = "status-indicator active";
				}

				// If unreachable, clamp target to max reach
				let solvX = x;
				let solvY = y;
				if (!reachable) {
					// Pull target to boundary
					const scale = (l1 + l2) / dist;
					// Just visualize it pointing towards it
				}

				// Law of Cosines for elbow angle
				// c^2 = a^2 + b^2 - 2ab cos(C)
				// dist^2 = l1^2 + l2^2 - 2*l1*l2 * cos(180 - t2)
				// cos(t2) = (x^2 + y^2 - l1^2 - l2^2) / (2*l1*l2)
				
				let c2 = (distSq - l1*l1 - l2*l2) / (2 * l1 * l2);
				
				// Clamp c2 due to floating point error
				if (c2 < -1) c2 = -1;
				if (c2 > 1) c2 = 1;

				// Elbow down solution usually preferred
				const s2 = -Math.sqrt(1 - c2*c2); // Elbow up/down choice here
				const t2 = Math.atan2(s2, c2);

				// Base angle
				// k1 = l1 + l2*cos(t2)
				// k2 = l2*sin(t2)
				// t1 = atan2(y, x) - atan2(k2, k1)
				
				const k1 = l1 + l2 * c2;
				const k2 = l2 * s2;
				const t1 = Math.atan2(y, x) - Math.atan2(k2, k1);

				joints.t1 = t1;
				joints.t2 = t2;

				// Forward Kinematics for joint positions (for drawing)
				joints.x1 = l1 * Math.cos(t1);
				joints.y1 = l1 * Math.sin(t1);
				
				joints.x2 = joints.x1 + l2 * Math.cos(t1 + t2);
				joints.y2 = joints.y1 + l2 * Math.sin(t1 + t2);

				// Update UI
				elTheta1.innerText = (t1 * 180 / Math.PI).toFixed(1) + '°';
				elTheta2.innerText = (t2 * 180 / Math.PI).toFixed(1) + '°';
				elTarget.innerText = `X: ${x.toFixed(0)} Y: ${y.toFixed(0)}`;
			}

			// Rendering
			function draw() {
				// Clear
				ctx.fillStyle = '#000';
				ctx.fillRect(0, 0, canvas.width, canvas.height);
				
				// Grid
				ctx.strokeStyle = '#222';
				ctx.lineWidth = 1;
				const gridSize = 50;
				ctx.beginPath();
				for(let x=0; x<canvas.width; x+=gridSize) { ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); }
				for(let y=0; y<canvas.height; y+=gridSize) { ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); }
				ctx.stroke();

				// Floor
				ctx.strokeStyle = '#444';
				ctx.lineWidth = 2;
				ctx.beginPath();
				ctx.moveTo(0, origin.y);
				ctx.lineTo(canvas.width, origin.y);
				ctx.stroke();

				// Coordinate Transform
				ctx.save();
				ctx.translate(origin.x, origin.y);
				ctx.scale(1, -1); // Flip Y to match math

				// Draw Reach Limit (faint)
				ctx.beginPath();
				ctx.strokeStyle = '#1a1a1a';
				ctx.arc(0, 0, l1 + l2, 0, Math.PI * 2);
				ctx.stroke();

				// Draw Target Ghost
				ctx.fillStyle = reachable ? 'rgba(0, 255, 204, 0.2)' : 'rgba(255, 50, 50, 0.2)';
				ctx.beginPath();
				ctx.arc(target.x, target.y, 10, 0, Math.PI*2);
				ctx.fill();

				// Draw Arm
				const j1x = joints.x1;
				const j1y = joints.y1;
				const j2x = joints.x2;
				const j2y = joints.y2;

				// Link 1
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.lineTo(j1x, j1y);
				ctx.lineWidth = 8;
				ctx.strokeStyle = '#3399ff'; // Blue
				ctx.lineCap = 'round';
				ctx.stroke();

				// Link 2
				ctx.beginPath();
				ctx.moveTo(j1x, j1y);
				ctx.lineTo(j2x, j2y);
				ctx.strokeStyle = '#00ffcc'; // Cyan
				ctx.stroke();

				// Joints
				// Base
				ctx.fillStyle = '#fff';
				ctx.beginPath(); ctx.arc(0, 0, 8, 0, Math.PI*2); ctx.fill();
				// Elbow
				ctx.fillStyle = '#222';
				ctx.beginPath(); ctx.arc(j1x, j1y, 6, 0, Math.PI*2); ctx.fill();
				ctx.strokeStyle = '#fff';
				ctx.lineWidth = 2;
				ctx.stroke();
				// End Effector
				ctx.fillStyle = reachable ? '#00ffcc' : '#ff3333';
				ctx.beginPath(); ctx.arc(j2x, j2y, 5, 0, Math.PI*2); ctx.fill();
				
				// Glow effect
				ctx.shadowColor = reachable ? '#00ffcc' : '#ff3333';
				ctx.shadowBlur = 15;
				ctx.beginPath(); ctx.arc(j2x, j2y, 2, 0, Math.PI*2); ctx.fill();
				ctx.shadowBlur = 0;

				ctx.restore();
			}

			// Boot
			resize();
			solveIK(); // Initial solve
		</script>
	</body>
</html>

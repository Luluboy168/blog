---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`PNG Compressor | ${SITE_TITLE}`} description="Compress PNG images in your browser using UPNG.js for true lossy/lossless optimization." />
        <script src="https://cdn.jsdelivr.net/npm/upng-js@2.1.0/UPNG.min.js" is:inline></script>
        <script src="https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js" is:inline></script>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-container">
				<div class="tool-header">
					<a href="/tools" class="back-link">← Back to Tools</a>
					<h1>PNG Compressor</h1>
					<p>Reduce PNG file size with local browser compression. 100% Privacy.</p>
				</div>

				<div class="converter-box">
					<div id="drop-zone" class="drop-zone">
						<div class="icon">🖼️</div>
						<p>Drag & Drop PNG file here</p>
						<button class="select-btn" onclick="document.getElementById('file-input').click()">Or Select File</button>
						<input type="file" id="file-input" accept="image/png" hidden>
					</div>

					<div class="controls" id="controls" style="display: none;">
						<div class="file-info">
							<span id="filename">image.png</span>
							<span id="filesize">0 MB</span>
						</div>
						
						<div class="options">
							<label>Target Quality:</label>
							<div class="quality-control">
								<input type="range" id="quality" min="0.1" max="1" step="0.1" value="0.7">
								<span id="quality-val">70%</span>
							</div>
                            <p class="hint">Lower quality = smaller file size.</p>
						</div>

						<button id="compress-btn" class="action-btn">Compress Now</button>
					</div>

					<div id="result-area" style="display: none;">
						<h3>Result</h3>
						<div class="stats-box">
                            <div class="stat-item">
                                <span class="label">Original:</span>
                                <span id="orig-size" class="value">0 KB</span>
                            </div>
                            <div class="stat-arrow">→</div>
                            <div class="stat-item">
                                <span class="label">Compressed:</span>
                                <span id="new-size" class="value">0 KB</span>
                            </div>
                            <div class="stat-reduction" id="reduction-tag">-0%</div>
                        </div>
						<div class="preview-container">
							<img id="preview-img" src="" alt="Compressed Image">
						</div>
						<a id="download-link" class="download-btn" download>Download Compressed PNG</a>
						<button id="reset-btn" class="text-btn">Compress Another</button>
					</div>

					<div id="loading" style="display: none;">
						<div class="spinner"></div>
						<p>Compressing PNG...</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const dropZone = document.getElementById('drop-zone');
	const fileInput = document.getElementById('file-input');
	const controls = document.getElementById('controls');
	const compressBtn = document.getElementById('compress-btn');
	const resultArea = document.getElementById('result-area');
	const loading = document.getElementById('loading');
	const qualityInput = document.getElementById('quality') as HTMLInputElement;
	const qualityVal = document.getElementById('quality-val');
	const previewImg = document.getElementById('preview-img') as HTMLImageElement;
	const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
	const resetBtn = document.getElementById('reset-btn');
    
    const origSizeElem = document.getElementById('orig-size');
    const newSizeElem = document.getElementById('new-size');
    const reductionElem = document.getElementById('reduction-tag');

	let currentFile: File | null = null;

	// Drag & Drop
	dropZone?.addEventListener('dragover', (e) => {
		e.preventDefault();
		dropZone.classList.add('dragover');
	});

	dropZone?.addEventListener('dragleave', () => {
		dropZone.classList.remove('dragover');
	});

	dropZone?.addEventListener('drop', (e) => {
		e.preventDefault();
		dropZone.classList.remove('dragover');
		if (e.dataTransfer?.files.length) {
			handleFile(e.dataTransfer.files[0]);
		}
	});

	fileInput?.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		if (target.files?.length) {
			handleFile(target.files[0]);
		}
	});

	function handleFile(file: File) {
		if (!file.type.includes('png') && !file.name.toLowerCase().endsWith('.png')) {
			alert('Please select a .png file');
			return;
		}
		currentFile = file;
		const filenameElem = document.getElementById('filename');
		const filesizeElem = document.getElementById('filesize');
		if (filenameElem) filenameElem.innerText = file.name;
		if (filesizeElem) filesizeElem.innerText = formatBytes(file.size);
		
		if (dropZone) dropZone.style.display = 'none';
		if (controls) controls.style.display = 'flex';
		if (resultArea) resultArea.style.display = 'none';
	}

    function formatBytes(bytes: number, decimals = 2) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

	qualityInput?.addEventListener('input', (e) => {
		const target = e.target as HTMLInputElement;
		if (qualityVal) qualityVal.innerText = Math.round(parseFloat(target.value) * 100) + '%';
	});

	compressBtn?.addEventListener('click', async () => {
		if (!currentFile) return;

		if (controls) controls.style.display = 'none';
		if (loading) loading.style.display = 'flex';

		try {
			const arrayBuffer = await currentFile.arrayBuffer();
            const img = (window as any).UPNG.decode(arrayBuffer);
            const rgba = (window as any).UPNG.toRGBA8(img)[0];
            
            // UPNG.encode parameters: (rgba_buffer, width, height, cnum, [dists])
            // cnum: number of colors in the palette (0 for lossless, 2-256 for lossy)
            const quality = parseFloat(qualityInput.value);
            const cnum = quality >= 1 ? 0 : Math.max(2, Math.round(256 * quality));
            
            const compressedArrayBuffer = (window as any).UPNG.encode([rgba], img.width, img.height, cnum);
            const blob = new Blob([compressedArrayBuffer], { type: 'image/png' });
            
            const url = URL.createObjectURL(blob);
            previewImg.src = url;
            
            downloadLink.href = url;
            downloadLink.download = 'compressed_' + currentFile!.name;

            if (origSizeElem) origSizeElem.innerText = formatBytes(currentFile!.size);
            if (newSizeElem) newSizeElem.innerText = formatBytes(blob.size);
            
            const reduction = Math.round(((currentFile!.size - blob.size) / currentFile!.size) * 100);
            if (reductionElem) {
                reductionElem.innerText = (reduction > 0 ? '-' : '+') + Math.abs(reduction) + '%';
                reductionElem.className = reduction > 0 ? 'stat-reduction pos' : 'stat-reduction neg';
            }

            if (loading) loading.style.display = 'none';
            if (resultArea) resultArea.style.display = 'flex';
		} catch (error) {
			console.error(error);
			alert('Compression failed. This tool requires UPNG.js to be loaded.');
			if (loading) loading.style.display = 'none';
			if (controls) controls.style.display = 'flex';
		}
	});

	resetBtn?.addEventListener('click', () => {
		currentFile = null;
		if (fileInput instanceof HTMLInputElement) fileInput.value = '';
		if (resultArea) resultArea.style.display = 'none';
		if (dropZone) dropZone.style.display = 'flex';
	});
</script>

<style>
	.tool-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
	}
	.tool-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.back-link {
		color: #888;
		text-decoration: none;
		font-size: 0.9rem;
		margin-bottom: 1rem;
		display: inline-block;
	}
	.back-link:hover {
		color: #fff;
	}
	.tool-header h1 {
		font-size: 2.5rem;
		margin: 0.5rem 0;
		background: linear-gradient(45deg, #ff8a00, #e52e71);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.converter-box {
		background: #1a1a1a;
		border: 1px solid #333;
		border-radius: 12px;
		padding: 3rem;
		min-height: 400px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.drop-zone {
		border: 2px dashed #444;
		border-radius: 12px;
		padding: 3rem;
		text-align: center;
		width: 100%;
		transition: all 0.2s;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.drop-zone.dragover {
		border-color: #ff8a00;
		background: rgba(255, 138, 0, 0.05);
	}
	.select-btn {
		background: #ff8a00;
		color: #000;
		border: none;
		padding: 10px 20px;
		border-radius: 6px;
		cursor: pointer;
		font-weight: bold;
		font-size: 1rem;
	}
	.controls {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.file-info {
		text-align: center;
		background: #222;
		padding: 1rem;
		border-radius: 8px;
	}
	.options {
		display: flex;
        flex-direction: column;
		gap: 1rem;
		align-items: center;
		max-width: 500px;
		margin: 0 auto;
	}
    .hint {
        font-size: 0.8rem;
        color: #666;
    }
	.quality-control {
		display: flex;
		align-items: center;
		gap: 1rem;
        width: 100%;
	}
	.quality-control input {
		flex: 1;
	}
	.action-btn {
		background: linear-gradient(45deg, #ff8a00, #e52e71);
		border: none;
		padding: 15px;
		border-radius: 8px;
		color: #fff;
		font-weight: bold;
		font-size: 1.1rem;
		cursor: pointer;
		width: 100%;
		max-width: 300px;
		margin: 0 auto;
	}
	.download-btn {
		background: #ff8a00;
		color: #000;
		padding: 12px 24px;
		text-decoration: none;
		border-radius: 6px;
		font-weight: bold;
		display: inline-block;
		margin: 1rem 0;
	}
	.text-btn {
		background: none;
		border: none;
		color: #888;
		cursor: pointer;
		text-decoration: underline;
	}
	.preview-container img {
		max-width: 100%;
		max-height: 300px;
		border-radius: 8px;
		border: 1px solid #444;
	}
	#result-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}
    .stats-box {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background: #222;
        padding: 1rem 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
    }
    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .stat-item .label {
        font-size: 0.7rem;
        color: #888;
        text-transform: uppercase;
    }
    .stat-item .value {
        font-weight: bold;
        font-size: 1.1rem;
    }
    .stat-arrow {
        color: #444;
        font-size: 1.5rem;
    }
    .stat-reduction {
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.9rem;
    }
    .stat-reduction.pos { background: #2e7d32; color: #fff; }
    .stat-reduction.neg { background: #c62828; color: #fff; }

	.spinner {
		width: 40px;
		height: 40px;
		border: 4px solid #333;
		border-top: 4px solid #ff8a00;
		border-radius: 50%;
		animation: spin 1s linear infinite;
		margin-bottom: 1rem;
	}
	@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
	
	input[type="range"] {
		accent-color: #ff8a00;
	}
</style>

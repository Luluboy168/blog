---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tools | ${SITE_TITLE}`} description="Useful developer tools running entirely in your browser." />
	</head>
	<body>
		<Header />
		<main>
			<section class="tools-hero">
				<h1>Developer Tools</h1>
				<p>Private, client-side utilities. No data leaves your browser.</p>
			</section>

			<div class="tools-grid">
				<a href="image-converter" class="tool-card">
					<div class="icon">🖼️</div>
					<h3>Image Converter</h3>
					<p>Convert HEIC files to JPG or PNG instantly.</p>
				</a>

				<a href="webp-converter" class="tool-card">
					<div class="icon">🚀</div>
					<h3>WebP Converter</h3>
					<p>Convert WebP images to JPG or PNG with quality control.</p>
				</a>

				<a href="video-converter" class="tool-card">
					<div class="icon">🎬</div>
					<h3>Video to GIF</h3>
					<p>Turn MP4 videos into animated GIFs.</p>
				</a>

				<a href="robot-arm-sim" class="tool-card">
					<div class="icon">🦾</div>
					<h3>Robot Arm Simulator</h3>
					<p>Interactive 2D Inverse Kinematics visualization.</p>
				</a>

				<a href="pid-sim" class="tool-card">
					<div class="icon">🎛️</div>
					<h3>PID Controller Sim</h3>
					<p>Visualize PID control dynamics with a drone simulation.</p>
				</a>

				<a href="path-planner" class="tool-card">
					<div class="icon">📍</div>
					<h3>Path Planner</h3>
					<p>Visualize A* search algorithm in real-time.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	.tools-hero {
		text-align: center;
		margin-bottom: 4rem;
	}
	.tools-hero h1 {
		font-size: 3rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(45deg, #00ffcc, #3399ff);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.tools-hero p {
		color: #888;
		font-size: 1.2rem;
	}
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	.tool-card {
		background: #1a1a1a;
		border: 1px solid #333;
		border-radius: 12px;
		padding: 2rem;
		text-decoration: none;
		color: #fff;
		transition: all 0.2s ease;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.tool-card:hover {
		transform: translateY(-5px);
		border-color: #00ffcc;
		box-shadow: 0 10px 30px rgba(0, 255, 204, 0.1);
	}
	.icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}
	.tool-card h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1.5rem;
	}
	.tool-card p {
		color: #888;
		margin: 0;
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Games | ${SITE_TITLE}`} description="Play retro games built with AI right in your browser." />
	</head>
	<body>
		<Header />
		<main>
			<section class="games-hero">
				<h1>Arcade</h1>
				<p>Retro-style games powered by WebAssembly and Canvas.</p>
			</section>

			<div class="games-grid">
				<a href="/blog/tetris/" class="game-card">
					<div class="icon">🧱</div>
					<h3>Tetris</h3>
					<p>The classic block-stacking puzzle game.</p>
				</a>

				<a href="/blog/crossy/" class="game-card">
					<div class="icon">🐔</div>
					<h3>Crossy Road</h3>
					<p>An isometric voxel-style infinite runner.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	.games-hero {
		text-align: center;
		margin-bottom: 4rem;
	}
	.games-hero h1 {
		font-size: 3rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(45deg, #ff00cc, #3399ff);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.games-hero p {
		color: #888;
		font-size: 1.2rem;
	}
	.games-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	.game-card {
		background: #1a1a1a;
		border: 1px solid #333;
		border-radius: 12px;
		padding: 2rem;
		text-decoration: none;
		color: #fff;
		transition: all 0.2s ease;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.game-card:hover {
		transform: translateY(-5px);
		border-color: #ff00cc;
		box-shadow: 0 10px 30px rgba(255, 0, 204, 0.1);
	}
	.icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}
	.game-card h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1.5rem;
	}
	.game-card p {
		color: #888;
		margin: 0;
	}
</style>

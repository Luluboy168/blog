---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="about-card card">
				<h1>About Luluboy</h1>
				<p>
					I am a student and researcher fascinated by the intersection of hardware, software, and human experience. My journey in technology is driven by a desire to understand how we can build more intuitive and capable systems.
				</p>
				<h2>Research Interests</h2>
				<ul>
					<li><strong>Robotics:</strong> Exploring the mechanical and algorithmic foundations of autonomous systems.</li>
					<li><strong>Software/Hardware Co-design:</strong> Optimizing the stack from silicon to application.</li>
					<li><strong>HCI (Human-Computer Interaction):</strong> Designing interfaces that bridge the gap between human intent and machine execution.</li>
				</ul>
				<p>
					This blog, <em>The Tech Pulse</em>, is my way of documenting my learning curve and sharing insights with the broader community.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-card {
		padding: 3rem;
	}
	h1 {
		color: var(--accent);
		margin-bottom: 2rem;
	}
	h2 {
		margin-top: 2rem;
		font-size: 1.8rem;
	}
	ul {
		list-style: none;
		padding: 0;
	}
	li {
		margin-bottom: 1rem;
		padding-left: 1.5rem;
		position: relative;
	}
	li::before {
		content: "▹";
		position: absolute;
		left: 0;
		color: var(--accent);
	}
</style>

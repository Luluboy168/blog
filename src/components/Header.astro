---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={`${import.meta.env.BASE_URL}/`}>{SITE_TITLE}</a></h2>
		<button class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="internal-links">
			<HeaderLink href={`${import.meta.env.BASE_URL}/`}>Home</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/archive/`}>Archive</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/research/`}>Research</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/games/`}>Games</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/tools/`}>Tools</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}/about/`}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: rgba(10, 12, 18, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		z-index: 101;
	}
	h2 a {
		color: #fff;
		text-decoration: none;
		letter-spacing: 1px;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 70px;
		max-width: 1200px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		font-size: 0.9em;
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: all 0.3s ease;
		padding: 0.5rem 0;
	}
	nav a:hover, nav a.active {
		color: var(--accent);
	}

	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		z-index: 101;
	}

	.mobile-menu-toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: #fff;
		margin: 5px 0;
		transition: 0.3s;
	}

	@media (max-width: 768px) {
		header {
			padding: 0 1rem;
		}
		.mobile-menu-toggle {
			display: block;
		}
		.internal-links {
			position: fixed;
			top: 0;
			right: -100%;
			width: 100%;
			height: 100vh;
			background: rgba(10, 12, 18, 0.98);
			flex-direction: column;
			align-items: center;
			justify-content: center;
			transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
			gap: 2rem;
			backdrop-filter: blur(20px);
		}
		.internal-links.active {
			right: 0;
		}
		nav a {
			font-size: 1.5rem;
		}
		
		/* Hamburger Animation */
		.mobile-menu-toggle.active span:nth-child(1) {
			transform: rotate(-45deg) translate(-5px, 5px);
		}
		.mobile-menu-toggle.active span:nth-child(2) {
			opacity: 0;
		}
		.mobile-menu-toggle.active span:nth-child(3) {
			transform: rotate(45deg) translate(-5px, -5px);
		}
	}
</style>

<script>
	const toggle = document.querySelector('.mobile-menu-toggle');
	const links = document.querySelector('.internal-links');
	
	toggle?.addEventListener('click', () => {
		toggle.classList.toggle('active');
		links?.classList.toggle('active');
		const isExpanded = toggle.classList.contains('active');
		toggle.setAttribute('aria-expanded', isExpanded.toString());
		document.body.style.overflow = isExpanded ? 'hidden' : '';
	});

	// Close menu when a link is clicked
	const navLinks = document.querySelectorAll('.internal-links a');
	navLinks.forEach(link => {
		link.addEventListener('click', () => {
			toggle?.classList.remove('active');
			links?.classList.remove('active');
			toggle?.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
		});
	});
</script>
